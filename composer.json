{
    "name": "letterncms/lettern",
    "description": "A new site. Run composer install, or open it in a browser and it fetches the release itself.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.1 <1"
    },
    "config": {
        "allow-plugins": {
            "letterncms/composer-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
